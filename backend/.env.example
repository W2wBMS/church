# Church 2.0 API — copy to .env and fill in. NEVER commit the real .env.
NODE_ENV=production
PORT=4000

# Supabase Dashboard → Connect → Session pooler connection string.
# Keep this server-side secret; never expose it in browser code.
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# Auth — generate a long random secret: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# MFA demo code (replace with real TOTP before real launch)
MFA_DEMO_CODE=123456

# Comma-separated allowed origins — your Vercel frontend URL(s)
CORS_ORIGINS=https://your-app.vercel.app
